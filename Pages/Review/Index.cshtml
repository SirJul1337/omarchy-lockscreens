@page "/review"
@using System.Text.Json
@model OmarchyLockscreens.Pages.Review.IndexModel
@{
    ViewData["Title"] = "Review";
}

<section class="zone">
    <div class="wrap">
        <h1 class="page">Review</h1>
        <p class="lede">Add a design from a GitHub issue — it's fetched, pinned to a commit, scanned, and waits here for your approval.</p>

        @if (Model.Error is not null)
        {
            <div class="alert bad">@Model.Error</div>
        }
        @if (Model.Notice is not null)
        {
            <div class="alert">@Model.Notice</div>
        }

        <form method="post" asp-page-handler="Add" class="win" style="margin-bottom: 32px;">
            <div class="win-tb"><span class="dots"><i></i><i></i><i></i></span><span>add a design</span></div>
            <div class="win-body" style="display: flex; flex-direction: column; gap: 14px;">
                <div style="display: flex; gap: 14px; flex-wrap: wrap;">
                    <div style="flex: 2 1 320px;">
                        <div class="field-label">repository URL</div>
                        <input type="url" asp-for="RepoUrl" placeholder="https://github.com/user/my-lock-design" required />
                    </div>
                    <div style="flex: 1 1 140px;">
                        <div class="field-label">tag or commit</div>
                        <input type="text" asp-for="Reference" placeholder="v1.0" required />
                    </div>
                </div>
                <div style="display: flex; gap: 14px; flex-wrap: wrap;">
                    <div style="flex: 1 1 200px;">
                        <div class="field-label">design file (.qml)</div>
                        <input type="text" asp-for="QmlPath" placeholder="MyDesign.qml" required />
                    </div>
                    <div style="flex: 1 1 200px;">
                        <div class="field-label">video file <span class="note">optional</span></div>
                        <input type="text" asp-for="VideoPath" placeholder="clip.mp4" />
                    </div>
                </div>
                <div style="display: flex; gap: 14px; flex-wrap: wrap;">
                    <div style="flex: 1 1 160px;">
                        <div class="field-label">name</div>
                        <input type="text" asp-for="Name" required />
                    </div>
                    <div style="flex: 1 1 140px;">
                        <div class="field-label">submitter (github)</div>
                        <input type="text" asp-for="OwnerLogin" placeholder="defaults to repo owner" />
                    </div>
                    <div style="flex: 1 1 160px;">
                        <div class="field-label">tags <span class="note">up to 3</span></div>
                        <input type="text" asp-for="TagInput" placeholder="minimal, clock" required />
                    </div>
                </div>
                <div>
                    <div class="field-label">description</div>
                    <textarea asp-for="Description" required></textarea>
                </div>
                <div>
                    <div class="field-label">issue URL <span class="note">optional — for your reference</span></div>
                    <input type="url" asp-for="IssueUrl" placeholder="https://github.com/.../issues/123" />
                </div>
                <button type="submit" class="btn" style="align-self: flex-start;">Fetch, scan &amp; queue</button>
            </div>
        </form>

        <h2 style="margin-bottom: 14px;">Pending <span style="color: var(--muted); font-weight: 400; font-size: 20px;">— @Model.Queue.Count</span></h2>
        <div style="display: flex; flex-direction: column; gap: 16px;">
            @foreach (var d in Model.Queue)
            {
                var v = d.Versions.OrderByDescending(x => x.Number).First();
                var lines = JsonSerializer.Deserialize<List<Dictionary<string, string>>>(v.ScanReportJson) ?? [];
                <div class="win @(v.ScanVerdict == OmarchyLockscreens.Models.ScanVerdict.Pass ? "" : "active")">
                    <div class="win-tb">
                        <span class="dots"><i></i><i></i><i></i></span>
                        <span>@d.PublicId · v@(v.Number) · pinned <a href="@(v.RepoUrl)/tree/@v.CommitSha" rel="noopener" style="color: var(--blue);">@v.CommitSha[..7]</a></span>
                        <span style="margin-left: auto;" class="status @(v.ScanVerdict switch { OmarchyLockscreens.Models.ScanVerdict.Pass => "approved", OmarchyLockscreens.Models.ScanVerdict.Warn => "pending", _ => "rejected" })">scan: @v.ScanVerdict.ToString().ToLowerInvariant()</span>
                    </div>
                    <div class="win-body">
                        <div style="display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap;">
                            <strong>@d.Name</strong>
                            <span style="color: var(--muted); font-size: 13.5px;">@("@" + d.OwnerLogin) · @d.Description</span>
                            @if (d.IssueUrl is not null)
                            {
                                <a href="@d.IssueUrl" rel="noopener" class="mono" style="font-size: 12px; margin-left: auto;">issue &rarr;</a>
                            }
                        </div>
                        <div style="margin: 12px 0;">
                            @foreach (var line in lines)
                            {
                                <div class="scanline @line["level"]">@line["text"]</div>
                            }
                        </div>
                        <form method="post" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                            <input type="hidden" name="versionId" value="@v.Id" />
                            <button type="submit" asp-page-handler="Approve" class="btn" disabled="@(v.ScanVerdict == OmarchyLockscreens.Models.ScanVerdict.Fail)">Approve &amp; list</button>
                            <input type="text" name="note" placeholder="rejection note" style="flex: 1 1 200px; max-width: 340px;" />
                            <button type="submit" asp-page-handler="Reject" class="btn danger">Reject</button>
                        </form>
                    </div>
                </div>
            }
            @if (Model.Queue.Count == 0)
            {
                <div class="mono" style="color: var(--muted);">Nothing pending. ✓</div>
            }
        </div>

        <h2 style="margin: 40px 0 14px;">Live <span style="color: var(--muted); font-weight: 400; font-size: 20px;">— @Model.Live.Count</span></h2>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            @foreach (var d in Model.Live)
            {
                <div class="win" style="display: flex; align-items: center; gap: 14px; padding: 12px 16px; flex-wrap: wrap;">
                    <strong>@d.Name</strong>
                    <span class="mono" style="font-size: 12px; color: var(--muted);">@d.PublicId · @("@" + d.OwnerLogin)</span>
                    <span class="status @d.Status.ToString().ToLowerInvariant()">@d.Status</span>
                    <form method="post" style="margin-left: auto;">
                        <input type="hidden" name="designId" value="@d.Id" />
                        <button type="submit" asp-page-handler="Revoke" class="btn danger">Revoke</button>
                    </form>
                </div>
            }
            @if (Model.Live.Count == 0)
            {
                <div class="mono" style="color: var(--muted);">No live designs yet.</div>
            }
        </div>
    </div>
</section>
