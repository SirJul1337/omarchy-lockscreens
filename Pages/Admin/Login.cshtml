@page "/admin/login"
@model OmarchyLockscreens.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin";
}

<section class="zone">
    <div class="wrap" style="max-width: 420px;">
        <div class="win">
            <div class="win-tb"><span class="dots"><i></i><i></i><i></i></span><span>admin login</span></div>
            <div class="win-body">
                @if (Model.Error is not null)
                {
                    <div class="alert bad">Wrong key.</div>
                }
                <form method="post" action="/admin/login" style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="field-label">admin key</div>
                    <input type="password" name="key" autofocus required autocomplete="off" />
                    <button type="submit" class="btn" style="align-self: flex-start;">Sign in</button>
                </form>
                <div class="mono" style="font-size: 12px; color: var(--muted); margin-top: 12px;">Maintainer access only. Visitors don't need to log in — they <a href="/apply">add designs by pull request</a>.</div>
            </div>
        </div>
    </div>
</section>
