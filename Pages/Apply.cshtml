@page "/apply"
@model OmarchyLockscreens.Pages.ApplyModel
@{
    ViewData["Title"] = "Add your design";
}

<section class="zone">
    <div class="wrap" style="max-width: 820px;">
        <div class="eyebrow">Add your design</div>
        <h1 class="page">Share your lock screen.</h1>
        <p class="lede">No account, no sign-up. A design is a pull request that adds one folder to this site's repository — your QML, a preview and a few lines about it. What a reviewer reads is what ships, and it stays there afterwards.</p>

        <div style="display: flex; flex-direction: column; gap: 16px;">
            <div class="win">
                <div class="win-tb"><span class="dots"><i></i><i></i><i></i></span><span>how it works</span></div>
                <div class="win-body" style="display: flex; flex-direction: column; gap: 14px;">
                    <div style="display: flex; gap: 14px;">
                        <span class="mono" style="color: var(--accent); font-weight: 700;">1</span>
                        <div>
                            <strong>Open a pull request</strong> adding <span class="mono">Designs/&lt;your-id&gt;/</span> —
                            a <span class="mono">design.json</span>, your <span class="mono">.qml</span>, and a
                            screenshot. Nothing else in the same pull request.
                        </div>
                    </div>
                    <div style="display: flex; gap: 14px;">
                        <span class="mono" style="color: var(--accent); font-weight: 700;">2</span>
                        <div>
                            <strong>It gets scanned and reviewed.</strong> The check runs automatically on your pull
                            request — only <span class="mono">QtQuick</span> and theme imports, no processes, network
                            or file access, size caps — and then a person reads the code.
                        </div>
                    </div>
                    <div style="display: flex; gap: 14px;">
                        <span class="mono" style="color: var(--accent); font-weight: 700;">3</span>
                        <div>
                            <strong>Merged designs are listed here</strong> with their preview, and reach the plugin's
                            Community tab once that ships.
                        </div>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                <a class="btn" href="@Model.ContributingUrl" rel="noopener" target="_blank">Read the instructions</a>
                <a class="btn ghost" href="@Model.RepoUrl" rel="noopener" target="_blank">Open the repository</a>
            </div>

            <div class="kv">
                <span style="color: var(--yellow);">rules:</span> your own work, contributed under the repository's MIT
                licence, nothing offensive or deceptive. Updating a design is another pull request to the same folder —
                the listed version stays live until the new one is merged. No video designs yet. The scanner only
                decides whether a design is technically dangerous; a person decides the rest.
            </div>
        </div>
    </div>
</section>
