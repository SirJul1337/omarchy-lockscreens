@model OmarchyLockscreens.Models.Design
@{
    // A design that did not arrive through the registry sync ships with the
    // plugin: you already have it, there is nothing to install.
    var builtIn = Model.LiveVersion?.ReviewedBy
        != OmarchyLockscreens.Services.RegistrySync.SyncActor;
}
@* omarchy.org's theme card: the screenshot is the card. No panel, no padding,
   a hairline round the image and one quiet line under it. *@
<a class="dcard" href="/designs/@Model.PublicId">
    <div class="thumb">
        <partial name="_Preview" model="Model" />
    </div>
    <span class="dcard-label">
        @Model.Name<span class="dcard-by">@(builtIn ? "built in" : "@" + Model.OwnerLogin)</span>
    </span>
</a>
